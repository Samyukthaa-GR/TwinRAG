[RULES]
RULE PUMP1-START
 IF Tank OHT level < 0.6
 THEN Pump PUMP1 status = OPEN
 PRIORITY 3
 ; end of rule

RULE PUMP1-STOP
 IF Tank OHT level > 1.9
 THEN Pump PUMP1 status = CLOSED
 PRIORITY 3
 ; end of rule


